# Copiar como .env (no se sube al repositorio). Vite solo expone al navegador las variables que empiezan con VITE_.

# Dirección base de la API para axios. Con /api/v1 el navegador llama al mismo origen:
# en desarrollo lo reenvía el proxy de Vite y en producción Nginx.
VITE_API_URL=/api/v1

# Backend al que el proxy de Vite reenvía /api en desarrollo (npm run dev).
VITE_BACKEND_URL=http://localhost:8080
