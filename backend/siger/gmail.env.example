# Copia este archivo como gmail.env (no se sube al repositorio) y completa los datos.
# Contraseña de aplicación: https://myaccount.google.com/apppasswords (requiere la verificación en dos pasos).

# Cuenta de Gmail que envía los correos de SIGER.
GMAIL_USUARIO=soporte.siger@gmail.com

# Contraseña de aplicación de 16 caracteres, sin espacios. No es la contraseña de la cuenta.
GMAIL_CONTRASENA=xxxxxxxxxxxxxxxx

# Opcional: buzón que recibe las solicitudes de soporte. Si se deja vacío, es la misma cuenta de arriba.
SIGER_SOPORTE_CORREO=
